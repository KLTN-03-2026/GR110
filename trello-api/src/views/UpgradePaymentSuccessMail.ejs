<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment successful - Taskio</title>
</head>
<body style="margin:0;padding:0;background-color:#f6f6f6;font-family:Tahoma,Verdana,Segoe,sans-serif;color:#374151;">
  <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;background-color:#f6f6f6;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table width="640" cellspacing="0" cellpadding="0" style="border-collapse:collapse;width:640px;max-width:100%;background:#ffffff;border:1px solid #e5e7eb;border-radius:14px;overflow:hidden;">
          <tr>
            <td style="background:linear-gradient(135deg,#ea6b3d 0%,#f08a5d 100%);padding:26px 36px;">
              <p style="margin:0 0 8px 0;font-size:13px;line-height:1.6;color:#ffe6dc;font-weight:700;letter-spacing:0.4px;text-transform:uppercase;">
                Taskio Billing
              </p>
              <h1 style="margin:0;font-size:28px;line-height:1.25;color:#ffffff;font-weight:700;">
                Upgrade payment successful
              </h1>
              <p style="margin:10px 0 0 0;font-size:14px;line-height:1.7;color:#fff1eb;">
                Your workspace has been upgraded and premium features are now active.
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:34px 36px;">
              <p style="margin:0 0 14px 0;font-size:16px;line-height:1.8;color:#111827;">
                Hello <strong><%= customerName || displayName || username || email || 'there' %></strong>,
              </p>

              <p style="margin:0 0 20px 0;font-size:15px;line-height:1.9;color:#4b5563;">
                Thank you for upgrading on <strong>Taskio</strong>. We have received your payment and activated your new plan.
              </p>

              <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:separate;border-spacing:0;margin:0 0 20px 0;background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:12px;">
                <tr>
                  <td style="padding:20px 22px;">
                    <p style="margin:0 0 10px 0;font-size:12px;line-height:1.6;color:#6b7280;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;">
                      Workspace
                    </p>
                    <p style="margin:0 0 14px 0;font-size:16px;line-height:1.7;color:#111827;font-weight:700;">
                      <%= workspaceName || '-' %>
                    </p>

                    <p style="margin:0 0 10px 0;font-size:12px;line-height:1.6;color:#6b7280;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;">
                      Plan
                    </p>
                    <p style="margin:0;font-size:15px;line-height:1.8;color:#111827;font-weight:600;">
                      <%= planName || 'Premium Plan' %>
                    </p>
                  </td>
                </tr>
              </table>

              <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:separate;border-spacing:0;margin:0 0 22px 0;background:linear-gradient(180deg,#fff7ed 0%,#fff1e6 100%);border:1px solid #fed7aa;border-left:5px solid #ea6b3d;border-radius:12px;">
                <tr>
                  <td style="padding:20px 22px;">
                    <p style="margin:0 0 14px 0;font-size:12px;line-height:1.6;color:#9a3412;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;">
                      Payment details
                    </p>

                    <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                      <tr>
                        <td style="padding:0 0 10px 0;font-size:14px;line-height:1.7;color:#7c2d12;">
                          Amount paid
                        </td>
                        <td align="right" style="padding:0 0 10px 0;font-size:14px;line-height:1.7;color:#111827;font-weight:700;">
                          <%= amount || '-' %> <%= currency || 'USD' %>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:0 0 10px 0;font-size:14px;line-height:1.7;color:#7c2d12;">
                          Transaction ID
                        </td>
                        <td align="right" style="padding:0 0 10px 0;font-size:14px;line-height:1.7;color:#111827;font-weight:700;">
                          <%= transactionId || '-' %>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:0 0 10px 0;font-size:14px;line-height:1.7;color:#7c2d12;">
                          Payment method
                        </td>
                        <td align="right" style="padding:0 0 10px 0;font-size:14px;line-height:1.7;color:#111827;font-weight:700;">
                          <%= paymentMethod || 'PayPal' %>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:0 0 10px 0;font-size:14px;line-height:1.7;color:#7c2d12;">
                          Paid at
                        </td>
                        <td align="right" style="padding:0 0 10px 0;font-size:14px;line-height:1.7;color:#111827;font-weight:700;">
                          <%= paidAt || '-' %>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:0;font-size:14px;line-height:1.7;color:#7c2d12;">
                          Next billing date
                        </td>
                        <td align="right" style="padding:0;font-size:14px;line-height:1.7;color:#111827;font-weight:700;">
                          <%= nextBillingDate || '-' %>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <div style="text-align:center;margin:24px 0 20px 0;">
                <a
                  href="<%= workspaceLink || '#' %>"
                  style="display:inline-block;padding:13px 26px;background-color:#ea6b3d;color:#ffffff;text-decoration:none;border-radius:8px;font-size:15px;font-weight:700;"
                >
                  Open Workspace
                </a>
              </div>

              <% if (typeof invoiceLink !== 'undefined' && invoiceLink) { %>
                <p style="margin:0 0 14px 0;font-size:14px;line-height:1.8;color:#4b5563;">
                  Invoice:
                  <a href="<%= invoiceLink %>" style="color:#ea6b3d;text-decoration:none;">
                    <%= invoiceLink %>
                  </a>
                </p>
              <% } %>

              <p style="margin:0;font-size:14px;line-height:1.8;color:#6b7280;">
                If you need billing support, please contact us at
                <strong><%= supportEmail || 'support@taskio.app' %></strong>.
              </p>

              <p style="margin:22px 0 0 0;font-size:15px;line-height:1.8;color:#111827;">
                Best regards,
              </p>
              <p style="margin:4px 0 0 0;font-size:15px;line-height:1.8;color:#111827;font-weight:700;">
                Taskio Team
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:18px 36px;background-color:#f9fafb;border-top:1px solid #e5e7eb;">
              <p style="margin:0;font-size:13px;line-height:1.8;color:#6b7280;text-align:center;">
                Taskio &copy; 2026 - Manage your tasks and teamwork efficiently.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
