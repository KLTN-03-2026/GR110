<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset your password - Taskio</title>
</head>
<body style="margin:0;padding:0;background-color:#f6f6f6;font-family:Tahoma,Verdana,Segoe,sans-serif;color:#374151;">
  <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;background-color:#f6f6f6;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table width="600" cellspacing="0" cellpadding="0" style="border-collapse:collapse;width:600px;max-width:100%;background:#ffffff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;">
          <tr>
            <td style="background-color:#ea6b3d;padding:20px 32px;">
              <h1 style="margin:0;font-size:24px;line-height:1.3;color:#ffffff;font-weight:700;">
                Taskio Support
              </h1>
              <p style="margin:6px 0 0 0;font-size:14px;line-height:1.6;color:#fde7df;">
                Password recovery request
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:32px;">
              <p style="margin:0 0 16px 0;font-size:16px;line-height:1.7;color:#111827;">
                Hello <strong><%= displayName || username || email %></strong>,
              </p>

              <p style="margin:0 0 16px 0;font-size:15px;line-height:1.8;color:#4b5563;">
                We received a request to reset the password for your <strong>Taskio</strong> account.
              </p>

              <p style="margin:0 0 16px 0;font-size:15px;line-height:1.8;color:#4b5563;">
                Click the button below to create a new password:
              </p>

              <div style="text-align:center;margin:28px 0;">
                <a
                  href="<%= resetPasswordLink %>"
                  style="display:inline-block;padding:14px 28px;background-color:#ea6b3d;color:#ffffff;text-decoration:none;border-radius:8px;font-size:15px;font-weight:700;"
                >
                  Reset Password
                </a>
              </div>

              <p style="margin:0 0 12px 0;font-size:14px;line-height:1.8;color:#4b5563;">
                If the button above does not work, copy and paste this link into your browser:
              </p>

              <p style="margin:0 0 20px 0;font-size:14px;line-height:1.8;color:#ea6b3d;word-break:break-all;">
                <%= resetPasswordLink %>
              </p>

              <table width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:20px 0;background-color:#fff7ed;border:1px solid #fed7aa;border-radius:10px;">
                <tr>
                  <td style="padding:20px;">
                    <p style="margin:0;font-size:14px;line-height:1.8;color:#9a3412;">
                      For security reasons, this password reset link should only be used by you. If you did not request a password reset, you can safely ignore this email.
                    </p>
                  </td>
                </tr>
              </table>

              <p style="margin:24px 0 0 0;font-size:15px;line-height:1.8;color:#111827;">
                Best regards,
              </p>
              <p style="margin:4px 0 0 0;font-size:15px;line-height:1.8;color:#111827;font-weight:700;">
                Taskio Team
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:18px 32px;background-color:#f9fafb;border-top:1px solid #e5e7eb;">
              <p style="margin:0;font-size:13px;line-height:1.7;color:#6b7280;text-align:center;">
                Taskio © 2025 — Manage your tasks and teamwork efficiently.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>